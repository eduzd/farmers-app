# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
# dist/ is committed (served by the server on Render)
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# Farmers: never commit secrets, local data or build leftovers
.env
.data/
server_dist/
*.zip
scripts/__pycache__/
# The web export is committed so Render does not need to run Expo
!dist/
!dist/**/node_modules/
!dist/**/build/
!dist/
!.env.example

# Local test scripts hold test logins: keep them off GitHub
scripts/
.vercel
dist-vercel/
