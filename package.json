{
  "name": "farmers",
  "main": "src/index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "tsx server/index.ts",
    "server:dev": "NODE_ENV=development tsx watch server/index.ts",
    "server:build": "esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=server_dist",
    "server:prod": "NODE_ENV=production node server_dist/index.js",
    "web:export": "expo export -p web --output-dir dist",
    "android:apk": "expo prebuild -p android --clean && cd android && ./gradlew assembleRelease",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint"
  },
