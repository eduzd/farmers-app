{
  "expo": {
    "name": "Farmers",
    "slug": "farmers",
    "owner": "dinaparp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "farmers",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.farmers.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#389466",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.farmers.app",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#389466",
          "dark": {
            "backgroundColor": "#1a472a"
          }
        }
      ],
      "expo-web-browser",
      "expo-audio",
      "expo-asset",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "barStyle": "dark"
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Farmers uses the camera for video features.",
          "microphonePermission": "Farmers uses the microphone for voice calls and voice messages."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Farmers needs your photos to set your profile picture.",
          "cameraPermission": "Farmers uses the camera to take your profile picture."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "506448c5-81c8-45ae-b73a-2f85302df243"
      }
    },
    "androidNavigationBar": {
      "enforceContrast": false
    }
  }
}