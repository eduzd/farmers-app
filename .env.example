# Copy this file to .env and fill in what you need.
# Everything marked optional can stay empty: the app still runs.

# Server
PORT=5000
NODE_ENV=production
# Required in production: any long random string (used to sign logins)
JWT_SECRET=
# Optional: comma-separated list of allowed web origins
CORS_ORIGINS=
# Optional: the public address of this server (used for the bKash return link).
# Empty = taken from the request's own address, which also works behind a tunnel.
PUBLIC_URL=

# Database (optional)
# Empty = data is saved to local files in DATA_DIR.
# Set to a Postgres URL (Neon or Supabase free tier) for a real database.
DATABASE_URL=
DATA_DIR=.data

# Firebase sign-in (email/password with verified email, and Google). The server
# accepts Firebase ID tokens from this project and turns off the old signup.
# Defaults to farms-31bf9. Set it to an empty value to go back to the old signup.
# FIREBASE_PROJECT_ID=farms-31bf9

# Admin: a NEW account created through a verified Firebase sign-in with this email
# becomes super admin and can open the Admin Dashboard (users, posts moderation,
# announcements, settings). Existing accounts are never promoted automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI features (Gemini). Optional: AI help is off without it.
# You can add up to 5 keys and the server rotates between them.
GOOGLE_API_KEY=
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=

# bKash payments. With BKASH_SANDBOX=true and no keys, bKash's public sandbox
# credentials are used, so test payments work out of the box. For real money set
# BKASH_SANDBOX=false and your merchant keys below.
BKASH_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Mobile app: where the phone app finds your server
# Example: https://your-server.onrender.com
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_DOMAIN=
